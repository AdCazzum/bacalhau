# Uniswap Developer Platform API key (https://developers.uniswap.org/dashboard)
# PoC posture: the key is used client-side (docs/08).
VITE_UNISWAP_API_KEY=your-key-here

# The Graph API key (https://thegraph.com/studio) — for subgraph queries.
VITE_GRAPH_API_KEY=your-key-here

# Subgraph query endpoint (Studio dev URL, or use VITE_GRAPH_SUBGRAPH_ID with a
# gateway API key for a published subgraph).
VITE_GRAPH_SUBGRAPH_URL=https://api.studio.thegraph.com/query/<id>/bacalhau-aqua/<version>
