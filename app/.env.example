# Uniswap Developer Platform API key (https://developers.uniswap.org/dashboard)
# Deliberately not VITE_*: it is read by the /uniswap proxy (the dev server
# locally, public/_worker.js on Cloudflare) and never inlined into the bundle.
UNISWAP_API_KEY=your-key-here

# The Graph API key (https://thegraph.com/studio) — for subgraph queries.
# Still client-side: the subgraph is queried straight from the browser (docs/08).
VITE_GRAPH_API_KEY=your-key-here

# Subgraph query endpoint (Studio dev URL, or use VITE_GRAPH_SUBGRAPH_ID with a
# gateway API key for a published subgraph).
VITE_GRAPH_SUBGRAPH_URL=https://api.studio.thegraph.com/query/<id>/qilinswap-aqua/<version>

# ---------- copilot (/agent) ----------
# All four are server-side only: the route runs in the Vite dev middleware
# locally and in the Pages worker in production, so no key reaches the browser.
# On Cloudflare set them with `wrangler pages secret put <NAME>`.

# Any OpenAI-compatible provider. Ours is OpenRouter.
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-3.6-flash

# Same Graph key as above, without the VITE_ prefix: the agent queries our
# subgraph and the hosted Subgraph MCP server from the server side.
GRAPH_API_KEY=your-key-here
GRAPH_SUBGRAPH_URL=https://api.studio.thegraph.com/query/<id>/qilinswap-aqua/<version>
